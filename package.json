{
	"$schema": "http://json.schemastore.org/package",
	"name": "@open-resource-discovery/overlay-tools",
	"version": "0.1.0",
	"description": "Tools for merging, validating, and converting ORD Overlay documents",
	"keywords": [
		"ord",
		"overlay",
		"openapi",
		"odata",
		"async-api",
		"resource-discovery"
	],
	"author": "SAP SE",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/open-resource-discovery/overlay-tools/issues"
	},
	"homepage": "https://github.com/open-resource-discovery/overlay-tools#readme",
	"main": "dist/src/index.js",
	"types": "dist/src/index.d.ts",
	"engines": {
		"node": ">=22.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/open-resource-discovery/overlay-tools.git"
	},
	"bin": {
		"ord-overlay": "dist/src/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"default": "./dist/src/index.js"
		},
		"./merge": {
			"types": "./dist/src/merge/merge.d.ts",
			"default": "./dist/src/merge/merge.js"
		},
		"./convert": {
			"types": "./dist/src/convert/index.d.ts",
			"default": "./dist/src/convert/index.js"
		}
	},
	"files": [
		"dist/src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p ./tsconfig.build.json",
		"build:test": "tsc -p ./tsconfig.json",
		"test": "npm run build:test && node --test dist/tests/merge/*.test.js dist/tests/validate/*.test.js dist/tests/convert/*.test.js",
		"test:merge": "npm run build:test && node --test dist/tests/merge/*.test.js",
		"test:validate": "npm run build:test && node --test dist/tests/validate/*.test.js",
		"test:convert": "npm run build:test && node --test dist/tests/convert/*.test.js",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "npm run lint && npm run format:check && npm test",
		"prepare": "npm run build",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"fast-xml-parser": "^5.8.0",
		"jsonpath": "^1.3.0",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/node": "25.9.5",
		"typescript": "7.0.2"
	},
	"overrides": {
		"underscore": "^1.13.8"
	}
}
